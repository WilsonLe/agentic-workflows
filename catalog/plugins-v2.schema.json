{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-workflows:catalog:v2",
  "title": "Agentic Workflows plugin catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harnesses",
    "marketplace",
    "reference_contract",
    "registry_contract",
    "packages",
    "mirrors",
    "documentation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "display_name",
        "path",
        "plugin_order"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "plugin_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "reference_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_roots",
        "local_asset_prefixes",
        "metadata_prompt_requires_skill_invocation",
        "required_authoring_skills"
      ],
      "properties": {
        "allowed_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "plugin-root",
              "skill-root"
            ]
          }
        },
        "local_asset_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "references",
              "scripts",
              "schemas",
              "examples",
              "templates"
            ]
          }
        },
        "metadata_prompt_requires_skill_invocation": {
          "type": "boolean"
        },
        "required_authoring_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fallback"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "fallback": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "registry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unavailable_source_prefix",
        "unverified_marker"
      ],
      "properties": {
        "unavailable_source_prefix": {
          "const": "external-unavailable:"
        },
        "unverified_marker": {
          "const": "not-live-verified"
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "mirrors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mirror"
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "central_router",
        "central_onboarding",
        "plugin_registry",
        "readme",
        "central_component_count",
        "repository_layout"
      ],
      "properties": {
        "central_router": {
          "type": "string",
          "minLength": 1
        },
        "central_onboarding": {
          "type": "string",
          "minLength": 1
        },
        "plugin_registry": {
          "type": "string",
          "minLength": 1
        },
        "readme": {
          "type": "string",
          "minLength": 1
        },
        "central_component_count": {
          "type": "integer",
          "minimum": 1
        },
        "repository_layout": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "harnesses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marketplace_path"
        ],
        "properties": {
          "marketplace_path": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation",
        "authentication"
      ],
      "properties": {
        "installation": {
          "enum": [
            "NOT_AVAILABLE",
            "AVAILABLE",
            "INSTALLED_BY_DEFAULT"
          ]
        },
        "authentication": {
          "enum": [
            "ON_INSTALL",
            "ON_USE"
          ]
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "agent_metadata",
        "harnesses",
        "prerequisites"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "agent_metadata": {
          "enum": [
            "required",
            "exempt"
          ]
        },
        "exemption_reason": {
          "type": "string",
          "minLength": 1
        },
        "harnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "required",
              "setup"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "setup": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "agent_metadata": {
                "const": "exempt"
              }
            }
          },
          "then": {
            "required": [
              "exemption_reason"
            ]
          }
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "display_name",
        "path",
        "category",
        "policy",
        "registry_name",
        "runtime_dependencies",
        "executables",
        "skills",
        "publisher",
        "harnesses"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "registry_name": {
          "type": "string",
          "minLength": 1
        },
        "runtime_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/skill"
          }
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "harnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string"
        }
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "source",
        "destination"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "exact_tree",
            "exact_file",
            "transformed_file",
            "prefixed_skill_set"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "source_prefix": {
          "type": "string"
        },
        "destination_prefix": {
          "type": "string"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replacements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/replacement"
          }
        }
      }
    }
  }
}
