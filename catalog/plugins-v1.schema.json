{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amsoft.vn/schemas/codex-plugin-catalog-v1.json",
  "title": "AMSoft Codex plugin catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "marketplace",
    "packages",
    "mirrors",
    "documentation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name", "path", "plugin_order"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "plugin_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/package"}
    },
    "mirrors": {
      "type": "array",
      "items": {"$ref": "#/$defs/mirror"}
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "central_router",
        "central_onboarding",
        "plugin_registry",
        "readme",
        "central_component_count",
        "repository_layout"
      ],
      "properties": {
        "central_router": {"type": "string", "minLength": 1},
        "central_onboarding": {"type": "string", "minLength": 1},
        "plugin_registry": {"type": "string", "minLength": 1},
        "readme": {"type": "string", "minLength": 1},
        "central_component_count": {"type": "integer", "minimum": 1},
        "repository_layout": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation", "authentication"],
      "properties": {
        "installation": {
          "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"]
        },
        "authentication": {
          "enum": ["ON_INSTALL", "ON_USE"]
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "agent_metadata"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "agent_metadata": {
          "enum": ["required", "exempt"]
        },
        "exemption_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"agent_metadata": {"const": "exempt"}}
          },
          "then": {
            "required": ["exemption_reason"]
          }
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "display_name",
        "path",
        "category",
        "policy",
        "registry_name",
        "runtime_dependencies",
        "executables",
        "skills"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "display_name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "policy": {"$ref": "#/$defs/policy"},
        "registry_name": {"type": "string", "minLength": 1},
        "runtime_dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "executables": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/skill"}
        }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string"}
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "source", "destination"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "exact_tree",
            "exact_file",
            "transformed_file",
            "prefixed_skill_set"
          ]
        },
        "source": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "source_prefix": {"type": "string"},
        "destination_prefix": {"type": "string"},
        "exclude": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "replacements": {
          "type": "array",
          "items": {"$ref": "#/$defs/replacement"}
        }
      }
    }
  }
}
