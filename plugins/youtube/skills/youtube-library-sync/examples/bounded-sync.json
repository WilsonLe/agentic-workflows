{
  "schema_version": 1,
  "operation": "sync",
  "urls": ["https://www.youtube.com/playlist?list=PLwiyx1dc3P2JR9N8gQaQN_BCvlSlap7re"],
  "auth_mode": "public",
  "rights_basis": {
    "category": "rights_holder_permission",
    "statement": "The rights holder authorized this bounded local archive."
  },
  "output_root": "/tmp/amsoft-youtube-archive",
  "playlist_policy": "playlist",
  "playlist_items": "1:5",
  "max_items": 5,
  "media_mode": "video",
  "max_resolution": 720,
  "subtitle_languages": ["en"],
  "subtitle_format": "vtt",
  "automatic_subtitles": false,
  "write_thumbnail": true,
  "embed_thumbnail": false,
  "embed_metadata": true,
  "embed_chapters": true,
  "split_chapters": false,
  "sections": [],
  "sponsorblock_mark": [],
  "sponsorblock_remove": [],
  "experimental_live_from_start": false,
  "overwrite": false,
  "rate_limit": "5M",
  "concurrent_fragments": 1,
  "sleep_requests": 5,
  "timeout": 3600
}
