{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amsoft.vn/schemas/youtube-operation-v1.json",
  "title": "AMSoft YouTube operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "urls"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"enum": ["inspect", "download", "sync"]},
    "urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    },
    "auth_mode": {"enum": ["public", "browser_cookie_file"], "default": "public"},
    "rights_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "statement"],
      "properties": {
        "category": {
          "enum": [
            "own_upload",
            "service_authorized",
            "rights_holder_permission",
            "public_domain",
            "open_license",
            "other_lawful_basis"
          ]
        },
        "statement": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "output_root": {"type": "string", "minLength": 1},
    "playlist_policy": {"enum": ["single", "playlist"], "default": "single"},
    "playlist_items": {"type": "string", "pattern": "^[-0-9,:]+$"},
    "max_items": {"type": "integer", "minimum": 1, "maximum": 100},
    "media_mode": {"enum": ["video", "audio", "section", "live"]},
    "max_resolution": {"enum": [144, 240, 360, 480, 720, 1080, 1440, 2160, 4320]},
    "max_filesize": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]+)?[KMG]?$"},
    "audio_format": {"enum": ["best", "aac", "alac", "flac", "m4a", "mp3", "opus", "vorbis", "wav"]},
    "subtitle_languages": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "subtitle_format": {"enum": ["best", "srt", "vtt", "ass", "lrc"]},
    "automatic_subtitles": {"type": "boolean"},
    "write_thumbnail": {"type": "boolean"},
    "embed_thumbnail": {"type": "boolean"},
    "embed_metadata": {"type": "boolean"},
    "embed_chapters": {"type": "boolean"},
    "split_chapters": {"type": "boolean"},
    "sections": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "sponsorblock_mark": {"$ref": "#/$defs/sponsorblock"},
    "sponsorblock_remove": {"$ref": "#/$defs/sponsorblock"},
    "experimental_live_from_start": {"type": "boolean"},
    "overwrite": {"const": false},
    "rate_limit": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]+)?[KMG]?$"},
    "concurrent_fragments": {"type": "integer", "minimum": 1, "maximum": 4},
    "sleep_requests": {"type": "number", "minimum": 0, "maximum": 30},
    "timeout": {"type": "integer", "minimum": 30, "maximum": 86400}
  },
  "$defs": {
    "sponsorblock": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sponsor",
          "intro",
          "outro",
          "selfpromo",
          "preview",
          "filler",
          "interaction",
          "music_offtopic",
          "hook",
          "poi_highlight"
        ]
      }
    }
  }
}
