{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amsoft.vn/schemas/wordpress-content-lock-v2.json",
  "title": "AMSoft WordPress content lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "project_key", "site_key", "environment",
    "identity", "serializer", "managed_fields", "guard", "remote", "local"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "wordpress-content-lock"},
    "project_key": {"type": "string", "minLength": 2},
    "site_key": {"type": "string", "minLength": 2},
    "environment": {"enum": ["local", "development", "staging", "production"]},
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9._:-]{0,198}$"
    },
    "serializer": {"const": "amsoft-wordpress-managed-object-json-v1"},
    "managed_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "guard": {"const": "atomic-compare-and-swap"},
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "modified_gmt", "sha256", "observed_at"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "modified_gmt": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
