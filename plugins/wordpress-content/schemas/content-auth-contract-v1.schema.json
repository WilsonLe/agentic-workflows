{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordPress Content Authentication Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_kind",
    "plugin",
    "site",
    "environment",
    "username",
    "auth_method",
    "credential_ref",
    "scopes",
    "last_verified_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_kind": {"const": "wordpress-content-auth"},
    "plugin": {"const": "wordpress-content"},
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "canonical_url"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "environment": {"enum": ["local", "staging", "production"]},
    "username": {"type": "string", "minLength": 1},
    "auth_method": {"const": "wordpress_application_password"},
    "credential_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "service", "account"],
      "properties": {
        "store": {"enum": ["macos-keychain", "windows-credential-manager", "secret-manager", "protected-file"]},
        "service": {"type": "string", "minLength": 1},
        "account": {"type": "string", "minLength": 1}
      }
    },
    "scopes": {
      "type": "array",
      "items": {"type": "string", "enum": ["pages", "posts", "media", "videos", "design-tokens"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "last_verified_at": {"type": "string", "format": "date-time"}
  }
}
