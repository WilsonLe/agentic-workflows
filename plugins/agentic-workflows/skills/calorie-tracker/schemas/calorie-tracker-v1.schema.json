{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-workflows:schema:calorie-tracker-v1.json",
  "title": "Agentic Workflows Calorie Tracker v1 records",
  "oneOf": [
    {"$ref": "#/$defs/meal_analysis"},
    {"$ref": "#/$defs/meal_record"},
    {"$ref": "#/$defs/storage_contract"},
    {"$ref": "#/$defs/provider_plan"},
    {"$ref": "#/$defs/operation_journal"}
  ],
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "nullable_number": {"type": ["number", "null"], "minimum": 0},
    "macros": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calories_kcal", "protein_g", "carbohydrate_g", "fat_g", "fiber_g",
        "total_sugar_g", "sodium_mg", "saturated_fat_g"
      ],
      "properties": {
        "calories_kcal": {"type": "number", "minimum": 0},
        "protein_g": {"type": "number", "minimum": 0},
        "carbohydrate_g": {"type": "number", "minimum": 0},
        "fat_g": {"type": "number", "minimum": 0},
        "fiber_g": {"$ref": "#/$defs/nullable_number"},
        "total_sugar_g": {"$ref": "#/$defs/nullable_number"},
        "sodium_mg": {"$ref": "#/$defs/nullable_number"},
        "saturated_fat_g": {"$ref": "#/$defs/nullable_number"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "statement"],
      "properties": {
        "type": {"enum": ["visible", "user", "provider", "inference"]},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "analysis_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_index", "description", "amount_g_estimate", "amount_low_g", "amount_high_g",
        "evidence", "provider", "provider_food_id", "provider_url", "retrieved_at",
        "macros_per_100g", "match_confidence", "match_reason"
      ],
      "properties": {
        "item_index": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1},
        "amount_g_estimate": {"type": "number", "exclusiveMinimum": 0},
        "amount_low_g": {"type": "number", "exclusiveMinimum": 0},
        "amount_high_g": {"type": "number", "exclusiveMinimum": 0},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "provider": {"enum": ["visible_label", "open_food_facts", "usda", "manual"]},
        "provider_food_id": {"type": ["string", "null"]},
        "provider_url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "macros_per_100g": {"$ref": "#/$defs/macros"},
        "match_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "match_reason": {"type": "string", "minLength": 1}
      }
    },
    "meal_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "intent", "observed_at", "timezone", "meal_label",
        "image", "items", "assumptions", "confidence"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "record_type": {"const": "meal_analysis"},
        "intent": {"enum": ["analyze", "track"]},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "timezone": {"type": "string", "minLength": 1},
        "meal_label": {"type": "string", "minLength": 1},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "authorized", "storage_authorized"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "authorized": {"const": true},
            "storage_authorized": {"type": "boolean"}
          }
        },
        "items": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/analysis_item"}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "meal_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "intent", "entry_id", "meal", "items", "record_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "record_type": {"const": "meal_record"},
        "intent": {"enum": ["analyze", "track"]},
        "entry_id": {"type": "string", "format": "uuid"},
        "meal": {"type": "object"},
        "items": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object"}},
        "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "storage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "contract_revision", "google_provider", "spreadsheet_id", "meals_tab",
        "meals_sheet_id", "items_tab", "items_sheet_id", "drive_folder_id", "timezone",
        "column_schema_version", "write_mode", "image_link_policy", "verified_at", "created_at", "updated_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_revision": {"type": "integer", "minimum": 1},
        "google_provider": {"const": "google-drive-connector"},
        "spreadsheet_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{10,200}$"},
        "meals_tab": {"type": "string", "minLength": 1},
        "meals_sheet_id": {"type": "integer", "minimum": 0},
        "items_tab": {"type": "string", "minLength": 1},
        "items_sheet_id": {"type": "integer", "minimum": 0},
        "drive_folder_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{10,200}$"},
        "timezone": {"type": "string", "minLength": 1},
        "column_schema_version": {"const": 1},
        "write_mode": {"const": "append-only"},
        "image_link_policy": {"const": "private-drive-url"},
        "verified_at": {"$ref": "#/$defs/timestamp"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "provider_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "requests"],
      "properties": {
        "schema_version": {"const": 1},
        "requests": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object"}}
      }
    },
    "operation_journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "entry_id", "state", "image_sha256", "record_digest",
        "spreadsheet_id", "drive_folder_id", "drive_file_id", "drive_url",
        "sheet_batch_digest", "failure", "created_at", "updated_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "entry_id": {"type": "string", "format": "uuid"},
        "state": {"enum": ["planned", "image_uploaded", "sheet_written_unverified", "verified", "failed_recoverable"]},
        "image_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "spreadsheet_id": {"type": "string"},
        "drive_folder_id": {"type": "string"},
        "drive_file_id": {"type": ["string", "null"]},
        "drive_url": {"type": ["string", "null"], "format": "uri"},
        "sheet_batch_digest": {"type": ["string", "null"]},
        "failure": {"type": ["string", "null"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
