{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-workflows:schema:qr-code-v1.schema.json",
  "title": "Agentic Workflows QR Code request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qr_id",
    "payload_type",
    "payload",
    "output",
    "error_correction",
    "style",
    "privacy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "qr_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "payload_type": {
      "enum": ["text", "url", "wifi", "vcard", "custom"]
    },
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "output": {"$ref": "#/$defs/output"},
    "error_correction": {"enum": ["L", "M", "Q", "H"]},
    "style": {"$ref": "#/$defs/style"},
    "logo": {"$ref": "#/$defs/logo"},
    "background": {"$ref": "#/$defs/background"},
    "privacy": {"$ref": "#/$defs/privacy"}
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "scale", "border"],
      "allOf": [
        {
          "if": {"required": ["width"]},
          "then": {"required": ["height"]}
        },
        {
          "if": {"required": ["height"]},
          "then": {"required": ["width"]}
        }
      ],
      "properties": {
        "format": {"enum": ["png", "svg"]},
        "scale": {"type": "integer", "minimum": 2, "maximum": 64},
        "border": {"type": "integer", "minimum": 4, "maximum": 32},
        "width": {"type": "integer", "minimum": 128, "maximum": 4096},
        "height": {"type": "integer", "minimum": 128, "maximum": 4096}
      }
    },
    "style": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["theme"],
          "properties": {
            "theme": {
              "enum": ["minimal", "editorial", "botanical", "night", "festival"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["theme", "dark", "light", "frame", "background"],
          "properties": {
            "theme": {"const": "custom"},
            "dark": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "light": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "frame": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "image_generation": {"type": "boolean"}
          }
        }
      ]
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "authorized"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "authorized": {"const": true}
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "authorized"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "authorized": {"const": true}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_raw_payload_in_manifest"],
      "properties": {
        "allow_raw_payload_in_manifest": {"type": "boolean"}
      }
    }
  }
}
