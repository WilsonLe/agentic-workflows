{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordPress DevOps Target Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_kind",
    "plugin",
    "project_key",
    "site_key",
    "environment",
    "provider",
    "provider_target",
    "provider_credential_ref",
    "ssh",
    "wordpress_root",
    "source_of_truth",
    "last_verified_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_kind": {"const": "wordpress-devops-target"},
    "plugin": {"const": "wordpress-devops"},
    "project_key": {"type": "string", "minLength": 1},
    "site_key": {"type": "string", "minLength": 1},
    "environment": {"enum": ["local", "staging", "production"]},
    "provider": {"enum": ["railway", "digitalocean"]},
    "provider_target": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "provider_credential_ref": {"type": "string", "minLength": 1},
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_alias", "user", "auth_source"],
      "properties": {
        "host_alias": {"type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "auth_source": {"enum": ["ssh-agent", "os-keychain", "secret-manager"]}
      }
    },
    "wordpress_root": {"type": "string", "minLength": 1},
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "branch"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1}
      }
    },
    "last_verified_at": {"type": "string", "format": "date-time"}
  }
}
