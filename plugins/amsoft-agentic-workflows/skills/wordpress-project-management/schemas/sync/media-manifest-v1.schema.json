{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amsoft.vn/schemas/wordpress-media-manifest-v1.json",
  "title": "AMSoft WordPress media manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "logical_id", "source_sha256", "mime_type", "bytes", "width", "height",
    "alt_text", "caption", "credit", "license", "storage", "status"
  ],
  "properties": {
    "logical_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{1,198}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mime_type": {"type": "string", "pattern": "^(image|video|audio|application)/[a-z0-9.+-]+$"},
    "bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
    "width": {"type": ["integer", "null"], "minimum": 1},
    "height": {"type": ["integer", "null"], "minimum": 1},
    "alt_text": {"type": "string"},
    "caption": {"type": "object"},
    "credit": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "storage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"enum": ["object-store", "release-artifact", "git-lfs"]},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["available", "missing", "replaced", "retired"]}
  }
}
