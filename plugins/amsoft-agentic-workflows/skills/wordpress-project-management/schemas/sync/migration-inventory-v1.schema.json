{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amsoft.vn/schemas/wordpress-migration-inventory-v1.json",
  "title": "AMSoft WordPress migration inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "project_key", "site_key", "environment",
    "generated_at", "site_fingerprint", "surfaces", "summary", "blocked"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "wordpress-migration-inventory"},
    "project_key": {"type": "string"},
    "site_key": {"type": "string"},
    "environment": {"enum": ["local", "development", "staging", "production"]},
    "generated_at": {"type": "string"},
    "site_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "surfaces": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity", "object_type", "disposition", "ownership", "classification",
          "compatibility", "reason", "dependencies"
        ],
        "properties": {
          "identity": {"type": "string"},
          "object_type": {"type": "string"},
          "disposition": {"type": "string"},
          "ownership": {"type": "string"},
          "classification": {"type": "string"},
          "compatibility": {"enum": ["supported", "blocked"]},
          "reason": {"type": "string"},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "blocked": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
