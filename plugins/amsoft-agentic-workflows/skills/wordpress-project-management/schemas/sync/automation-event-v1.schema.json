{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amsoft.vn/schemas/wordpress-sync-automation-event-v1.json",
  "title": "AMSoft WordPress synchronization automation event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event", "site_key", "environment", "identity",
    "correlation_id", "actor", "autosave", "revision", "classification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event": {"enum": ["wordpress-save", "git-merge"]},
    "site_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "environment": {"enum": ["local", "development", "staging", "production"]},
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9._:-]{0,198}$"
    },
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "actor": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 128},
        {"type": "integer", "minimum": 0}
      ]
    },
    "autosave": {"type": "boolean"},
    "revision": {"type": "boolean"},
    "classification": {"enum": ["public", "internal", "restricted"]}
  }
}
