{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amsoft.vn/schemas/wordpress-content-lock-v1.json",
  "title": "WordPress content lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site",
    "environment",
    "object",
    "managed_fields",
    "serializer",
    "remote",
    "concurrency_guard"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "site": {"type": "string", "minLength": 1},
    "environment": {"enum": ["local", "staging", "production"]},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "canonical_url"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "integer", "minimum": 1},
        "canonical_url": {"type": "string", "format": "uri"}
      }
    },
    "managed_fields": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "serializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "canonicalization"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "canonicalization": {"type": "string", "minLength": 1}
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "modified_gmt", "checksum_sha256", "fetched_at"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "modified_gmt": {"type": "string", "format": "date-time"},
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fetched_at": {"type": "string", "format": "date-time"}
      }
    },
    "concurrency_guard": {
      "enum": ["atomic-compare-and-swap", "best-effort-preflight", "unavailable"]
    }
  }
}
