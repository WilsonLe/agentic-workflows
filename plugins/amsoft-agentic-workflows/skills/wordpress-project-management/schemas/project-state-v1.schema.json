{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amsoft.vn/schemas/wordpress-project-state-v1.json",
  "title": "WordPress project state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "target",
    "source",
    "runtime",
    "wordpress",
    "verification",
    "change"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "canonical_urls", "fingerprint"],
      "properties": {
        "environment": {"enum": ["local", "staging", "production"]},
        "canonical_urls": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "format": "uri"}
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "compose_project", "wordpress_site_url"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "compose_project": {"type": "string", "minLength": 1},
            "service": {"type": "string", "minLength": 1},
            "wordpress_site_url": {"type": "string", "format": "uri"},
            "table_prefix": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "truth_register"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "truth_register": {"type": "array", "items": {"type": "string"}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "wp_cli", "database"],
      "properties": {
        "adapter": {"enum": ["rest", "wp-cli", "wp-admin", "builder", "unknown"]},
        "wp_cli": {"enum": ["available", "unavailable", "unknown"]},
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "table_prefix"],
          "properties": {
            "identity": {"type": "string", "minLength": 1},
            "table_prefix": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "wordpress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_version", "multisite", "theme", "plugins"],
      "properties": {
        "core_version": {"type": "string", "minLength": 1},
        "multisite": {"type": "boolean"},
        "theme": {"type": "string", "minLength": 1},
        "plugins": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "known_blockers"],
      "properties": {
        "channels": {"type": "array", "items": {"type": "string"}},
        "known_blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approval", "managed_objects"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "approval": {"type": "string", "minLength": 1},
        "managed_objects": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
