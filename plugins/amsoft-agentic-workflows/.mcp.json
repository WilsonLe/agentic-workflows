{
  "mcpServers": {
    "amsoft-cloudflare-account": {
      "command": "node",
      "args": [
        "./mcp/amsoft-cloudflare-account.mjs",
        "--stdio"
      ],
      "cwd": ".",
      "env_vars": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ],
      "tool_timeout_sec": 120
    }
  }
}
