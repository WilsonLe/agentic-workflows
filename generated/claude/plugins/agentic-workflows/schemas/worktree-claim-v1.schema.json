{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-workflows:schema:agent-orchestration/worktree-claim-v1",
  "title": "Agent Orchestration worktree ownership claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worktree_identity",
    "state",
    "controller_id",
    "task_id",
    "revision",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "worktree_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Stable realpath-normalized identity; it does not switch from a path key to an inode key when a missing worktree is created."
    },
    "state": {"enum": ["claimed", "released"]},
    "controller_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "task_id": {"type": ["string", "null"], "maxLength": 200},
    "revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
