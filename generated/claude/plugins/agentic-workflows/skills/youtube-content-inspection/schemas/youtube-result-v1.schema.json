{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-workflows:schema:youtube-result-v1.json",
  "title": "Agentic Workflows YouTube sanitized result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "operation", "auth_mode", "command", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"const": true},
    "operation": {"enum": ["inspect", "download", "sync"]},
    "auth_mode": {"enum": ["public", "browser_cookie_file"]},
    "command": {"type": "array", "items": {"type": "string"}},
    "records": {"type": "array"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
